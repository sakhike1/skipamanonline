# Production Environment Variables Template
# Copy this file to .env.production and fill in your actual values

# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (MongoDB Atlas recommended for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/skipaman_store?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb+srv://username:password@cluster.mongodb.net/skipaman_store_test?retryWrites=true&w=majority

# JWT Configuration (Generate strong, unique secrets)
JWT_SECRET=your-super-secure-jwt-secret-key-here-minimum-32-characters
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-here-minimum-32-characters
JWT_REFRESH_EXPIRE=30d

# Email Configuration (for notifications and order confirmations)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# Frontend URL (your live website domain)
FRONTEND_URL=https://yourdomain.com

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Rate Limiting (prevent abuse)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Socket.io Configuration (for real-time features)
SOCKET_CORS_ORIGIN=https://yourdomain.com

# Additional Production Settings
# Uncomment and configure as needed:

# Redis Configuration (for caching and sessions)
# REDIS_URL=redis://localhost:6379

# AWS S3 Configuration (for file storage)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-s3-bucket-name

# Payment Gateway Configuration
# STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Analytics and Monitoring
# SENTRY_DSN=your-sentry-dsn
# GOOGLE_ANALYTICS_ID=your-ga-id

# Security
# BCRYPT_ROUNDS=12
# SESSION_SECRET=your-session-secret









